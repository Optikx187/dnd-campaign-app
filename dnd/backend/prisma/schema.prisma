// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String?
  googleId     String?  @unique
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  characters   Character[]
  campaigns    Campaign[]
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  dmId        String
  worldData   Json?
  createdAt   DateTime @default(now())
  
  dm          User         @relation(fields: [dmId], references: [id])
  characters  Character[]
  npcs        NPC[]
  sessions    Session[]
}

model Character {
  id         String   @id @default(uuid())
  userId     String
  campaignId String?
  name       String
  race       String?
  class      String?
  level      Int      @default(1)
  stats      Json?
  inventory  Json?
  createdAt  DateTime @default(now())
  
  user       User      @relation(fields: [userId], references: [id])
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
}

model NPC {
  id            String   @id @default(uuid())
  campaignId    String
  name          String
  description   String?
  personality   Json?
  voiceProfile  Json?
  createdAt     DateTime @default(now())
  
  campaign      Campaign @relation(fields: [campaignId], references: [id])
}

model Session {
  id          String   @id @default(uuid())
  campaignId  String
  chatHistory Json?
  createdAt   DateTime @default(now())
  
  campaign    Campaign @relation(fields: [campaignId], references: [id])
}

model Item {
  id          String   @id @default(uuid())
  name        String
  description String?
  stats       Json?
  type        String?
  createdAt   DateTime @default(now())
}
